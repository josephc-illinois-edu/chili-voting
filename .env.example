# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Admin Authentication
# Generate with: openssl rand -base64 32
ADMIN_SECRET_KEY=your-secure-admin-password
NEXT_PUBLIC_ADMIN_SECRET_KEY=your-secure-admin-password

# Event Configuration
NEXT_PUBLIC_EVENT_NAME="Chili Cook-Off 2025"
NEXT_PUBLIC_EVENT_DATE="November 19, 2025"
NEXT_PUBLIC_EVENT_TIME="11:00 AM – 1:30 PM"

# Upload Deadline (ISO 8601 format)
# After this time, contestants cannot upload photos or edit entries
NEXT_PUBLIC_UPLOAD_DEADLINE="2025-11-19T11:00:00"

# Google Sheets Integration (Optional)
# Required only if using Google Forms → Google Sheets import feature
# See: docs/setup/GOOGLE_SHEETS_SETUP.md for complete setup instructions

# Option 1: Full JSON credentials (recommended for deployment)
GOOGLE_SHEETS_CREDENTIALS='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-sa@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Option 2: Separate fields (alternative to Option 1)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your-spreadsheet-id

# Optional: Base URL for production deployment
# Used for generating QR codes and absolute URLs
# NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
